<rml>
<head>
    <title>World Forge Zero</title>

    <style>
        body
        {
            width: 100%;
            height: 100%;

            margin: 0;
            padding: 0;

            display: flex;
            justify-content: center;
            align-items: center;

            background-color: #0d0f14;

            color: #d8dce6;

            font-family: Monocraft;
            font-size: 18px;
        }

        #main-panel
        {
            width: 520px;

            padding: 32px;

            display: flex;
            flex-direction: column;

            background-color: #171a21;

            border-width: 1px;
            border-color: #303642;

            border-radius: 6px;
        }

        #title
        {
            display: block;

            margin-bottom: 8px;

            font-size: 32px;
            color: #f2f4f8;
        }

        #subtitle
        {
            display: block;

            margin-bottom: 28px;

            font-size: 16px;
            color: #8992a3;
        }

        #status
        {
            display: block;

            margin-bottom: 24px;

            padding: 12px 14px;

            background-color: #11141a;

            border-width: 1px;
            border-color: #292f3a;

            color: #b8c0cf;
        }

        .menu-button
        {
            width: 100%;

            margin-top: 6px;
            padding: 12px 16px;

            background-color: #242a35;

            border-width: 1px;
            border-color: #394150;
            border-radius: 4px;

            color: #e8ebf0;

            font-family: Monocraft;
            font-size: 18px;

            text-align: left;
        }

        .menu-button:hover
        {
            background-color: #303846;
            border-color: #596477;
        }

        .menu-button:active
        {
            background-color: #1c212a;
        }

        #footer
        {
            display: block;

            margin-top: 24px;

            font-size: 13px;
            color: #596171;
        }
    </style>
</head>

<body>
    <div id="main-panel">
        <div id="title">
            World Forge Zero
        </div>

        <div id="subtitle">
            Launcher
        </div>

        <div id="status">
            RmlUi работает. Кириллица работает. Пока никто не умер.
        </div>

        <button class="menu-button">
            Играть
        </button>

        <button class="menu-button">
            Новости
        </button>

        <button class="menu-button">
            Настройки
        </button>

        <button class="menu-button">
            О программе
        </button>

        <div id="footer">
            WFZ Launcher 0.0.1
        </div>
    </div>
</body>
</rml>
