<rml>

    <head>
        <title>Информация</title>

        <link type="text/rcss" href="../common.rcss" />
        <link type="text/rcss" href="info.rcss" />
    </head>

    <body>
        <div class="page-title">
            ИНФОРМАЦИЯ
        </div>

        <div class="header-line"></div>

        <div id="info-content">
            <div id="info-launcher-title">
                WORLD FORGE ZERO LAUNCHER
            </div>

            <div id="info-version">
                Версия лаунчера v<span id="info-launcher-version">0.0.1</span>
            </div>

            <div id="info-description">
                Лаунчер для установки, обновления и запуска World Forge Zero.
            </div>

            <div id="third-party-title">
                СТОРОННЕЕ ПО
            </div>

            <div class="third-party-row">
                <div class="third-party-name">RmlUi</div>
                <div class="third-party-version"></div>
                <div class="third-party-license">MIT</div>
            </div>

            <div class="third-party-row">
                <div class="third-party-name">GLFW</div>
                <div class="third-party-version"></div>
                <div class="third-party-license">zlib/libpng</div>
            </div>

            <div class="third-party-row">
                <div class="third-party-name">FreeType</div>
                <div class="third-party-version">2.13.3</div>
                <div class="third-party-license">FTL/GPL-2.0</div>
            </div>

            <div class="third-party-row">
                <div class="third-party-name">OpenSSL</div>
                <div class="third-party-version">3.5.8</div>
                <div class="third-party-license">Apache-2.0</div>
            </div>

            <div class="third-party-row">
                <div class="third-party-name">cpp-httplib</div>
                <div class="third-party-version"></div>
                <div class="third-party-license">MIT</div>
            </div>

            <div class="third-party-row">
                <div class="third-party-name">nlohmann/json</div>
                <div class="third-party-version"></div>
                <div class="third-party-license">MIT</div>
            </div>

            <div class="third-party-row">
                <div class="third-party-name">Monocraft</div>
                <div class="third-party-version">4.2.1</div>
                <div class="third-party-license">OFL-1.1</div>
            </div>
        </div>

        <div class="footer">
            <div class="footer-line"></div>

            <button id="info-back" class="back-button">
                НАЗАД
            </button>
        </div>
    </body>
</rml>
