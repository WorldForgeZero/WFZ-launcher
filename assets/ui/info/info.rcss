.header-line {
    top: 72px;
}

#info-content {
    position: absolute;

    left: 32px;
    right: 50px;

    top: 92px;
    bottom: 74px;

    padding-top: 18px;
    padding-bottom: 24px;

    overflow-y: auto;
}

#info-launcher-title {
    margin-bottom: 12px;

    font-size: 26px;
    color: #e8e8e8;
}

#info-version {
    margin-bottom: 22px;

    font-size: 18px;
    color: #b9b9b9;
}

#info-description {
    margin-bottom: 32px;

    font-size: 18px;
    color: #b9b9b9;
}

#third-party-title {
    margin-bottom: 16px;

    font-size: 20px;
    color: #ff9800;
}

.third-party-row {
    height: 40px;

    display: flex;
    flex-direction: row;

    align-items: flex-start;
}

.third-party-name {
    width: 220px;

    font-size: 20px;
    color: #e8e8e8;
}

.third-party-version {
    width: 120px;

    font-size: 18px;
    color: #9a9a9a;
}

.third-party-license {
    flex: 1;

    font-size: 18px;
    color: #b9b9b9;
}
