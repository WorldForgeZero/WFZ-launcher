.header-line {
    top: 128px;
}

#settings-search {
    position: absolute;

    left: 32px;
    right: 32px;
    top: 72px;

    height: 44px;

    padding-left: 14px;
    padding-right: 14px;

    font-family: Monocraft;
    font-size: 18px;

    color: #e8e8e8;
    background-color: #1c1c1c;

    border-width: 1px;
    border-color: #414141;
    border-radius: 4px;
}

#settings-search:hover,
#settings-search:focus {
    background-color: #2a2a2a;
    border-color: #ff9800;
}

#settings-content {
    position: absolute;

    left: 32px;
    right: 50px;

    top: 140px;
    bottom: 74px;

    padding-top: 16px;
    padding-bottom: 16px;

    overflow-y: auto;
}

.settings-panel {
    margin-bottom: 18px;

    padding: 0 10px 12px 10px;

    background-color: #1c1c1c;

    border-width: 1px;
    border-color: #414141;
    border-radius: 5px;
}

.settings-panel-title {
    margin-left: 10px;
    margin-top: 16px;
    margin-bottom: 14px;

    font-size: 22px;
    color: #e8e8e8;
}

.settings-panel-line {
    height: 1px;

    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 10px;

    background-color: #414141;
}

.setting-row {
    min-height: 64px;

    margin-bottom: 10px;
    padding: 14px 14px 14px 16px;

    display: flex;
    flex-direction: row;
    align-items: flex-start;

    border-radius: 4px;
}

.setting-row:hover {
    background-color: #2a2a2a;
}

.setting-text {
    flex: 1;
}

.setting-title {
    margin-bottom: 12px;

    font-size: 22px;
    color: #e8e8e8;
}

.setting-description {
    margin-right: 18px;

    font-size: 17px;
    color: #b9b9b9;
}

.setting-row input {
    width: 24px;
    height: 24px;

    margin-left: 14px;
}

#settings-empty {
    display: none;

    margin: 20px 8px;

    font-size: 22px;
    color: #b9b9b9;
}

#settings-back {
    left: auto;
    right: 32px;

    width: 142px;
    height: 44px;

    font-size: 20px;
}
