#news-tabs {
    position: absolute;

    left: 4%;
    top: 72px;

    width: 328px;
    height: 42px;

    display: flex;
    flex-direction: row;

    align-items: stretch;
}

.news-tab {
    position: relative;

    width: 160px;
    height: 42px;

    margin-right: 8px;
    padding: 0;

    flex: none;

    display: flex;
    flex-direction: row;

    align-items: center;
    justify-content: center;

    font-family: Monocraft;
    font-size: 17px;

    color: #b9b9b9;
    background-color: transparent;

    border-width: 0;
    border-radius: 4px;
}

.news-tab:hover {
    background-color: #1c1c1c;
    color: #e8e8e8;
}

.news-tab.active {
    background-color: #1c1c1c;
    color: #e8e8e8;

    border-bottom-width: 2px;
    border-bottom-color: #ff9800;
}

.unread-dot {
    position: absolute;

    right: 9px;
    top: 8px;

    width: 7px;
    height: 7px;

    background-color: #ff9800;

    border-radius: 4px;
}

#news-header-line {
    position: absolute;

    left: 4%;
    top: 122px;

    width: 92%;
    height: 1px;

    background-color: #414141;
}

#news-content {
    top: 136px;
    bottom: 76px;
}

.news-date,
.news-author-name,
.news-item-text,
#news-status {
    text-align: left;
}

#news-status {
    width: 100%;

    margin-top: 100px;

    text-align: center;

    font-size: 18px;
    color: #9a9a9a;
}

#news-list {
    display: none;

    width: 100%;
}

.news-day {
    width: 100%;

    margin-bottom: 26px;
}

.news-date {
    padding-bottom: 10px;

    font-size: 19px;
    color: #e8e8e8;

    border-bottom-width: 1px;
    border-bottom-color: #414141;
}

.news-day.unread .news-date {
    border-bottom-color: #ff9800;
}

.news-author {
    margin-top: 14px;
    margin-bottom: 12px;
}

.news-author-name {
    margin-bottom: 10px;

    font-size: 18px;
    color: #e8e8e8;
}

.news-item {
    width: 100%;
    min-height: 26px;

    margin-bottom: 8px;

    display: flex;
    flex-direction: row;

    align-items: flex-start;
}

.news-kind {
    width: 52px;
    height: 24px;

    margin-right: 12px;

    flex: none;

    text-align: center;

    font-size: 14px;
    line-height: 24px;

    color: #ff9800;
    background-color: #1c1c1c;

    border-width: 1px;
    border-color: #414141;
    border-radius: 3px;
}

.news-item-text {
    flex: 1;

    padding-top: 2px;

    font-size: 16px;
    color: #b9b9b9;
}
