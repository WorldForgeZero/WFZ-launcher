#news-title {
    position: absolute;

    left: 28px;
    top: 22px;

    font-size: 30px;
    color: #e8e8e8;
}

#news-tabs {
    position: absolute;

    left: 28px;
    top: 66px;

    height: 42px;

    display: flex;
    flex-direction: row;
}

.news-tab {
    position: relative;

    width: 160px;
    height: 42px;

    margin-right: 8px;

    font-size: 18px;

    color: #b9b9b9;

    background-color: transparent;

    border-width: 0;
    border-radius: 4px;
}

.news-tab:hover {
    background-color: #1c1c1c;
    color: #e8e8e8;
}

.news-tab.active {
    background-color: #1c1c1c;
    color: #e8e8e8;

    border-bottom-width: 2px;
    border-bottom-color: #ff9800;
}

.unread-dot {
    position: absolute;

    right: 9px;
    top: 8px;

    width: 7px;
    height: 7px;

    border-radius: 4px;

    background-color: #ff9800;
}

#news-header-line {
    position: absolute;

    left: 28px;
    right: 32px;

    top: 120px;
    height: 1px;

    background-color: #414141;
}

#news-content {
    position: absolute;

    left: 28px;
    right: 50px;

    top: 136px;
    bottom: 74px;

    padding-top: 18px;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 24px;

    overflow-y: auto;
}

#news-status {
    width: 100%;

    margin-top: 100px;

    text-align: center;

    font-size: 20px;
    color: #9a9a9a;
}

#news-list {
    display: none;
}

.news-day {
    margin-bottom: 26px;
}

.news-date {
    padding-bottom: 10px;

    font-size: 21px;
    color: #e8e8e8;

    border-bottom-width: 1px;
    border-bottom-color: #414141;
}

.news-day.unread .news-date {
    border-bottom-color: #ff9800;
}

.news-author {
    margin-top: 14px;
    margin-bottom: 12px;
}

.news-author-name {
    margin-bottom: 11px;

    font-size: 19px;
    color: #e8e8e8;
}

.news-item {
    min-height: 24px;

    margin-bottom: 8px;

    display: flex;
    flex-direction: row;
}

.news-kind {
    width: 52px;
    height: 24px;

    margin-right: 12px;

    text-align: center;

    font-size: 14px;
    line-height: 24px;

    color: #ff9800;

    background-color: #1c1c1c;

    border-width: 1px;
    border-color: #414141;
    border-radius: 3px;
}

.news-item-text {
    flex: 1;

    padding-top: 1px;

    font-size: 18px;
    color: #b9b9b9;
}
