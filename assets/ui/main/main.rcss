#background {
    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    background-color: #181818;

    decorator: linear-gradient(to bottom, #141414, #040404);
}

#title {
    position: absolute;

    left: 32px;
    top: 30px;

    font-size: 32px;
    color: #e8e8e8;
}

#launcher-version {
    position: absolute;

    left: 34px;
    top: 78px;

    font-size: 16px;
    color: #9a9a9a;
}

.navigation-button {
    position: absolute;

    top: 25px;
    height: 44px;

    padding: 0;

    font-family: Monocraft;
    font-size: 16px;

    color: #e8e8e8;
    background-color: #1c1c1c;

    border-width: 1px;
    border-color: #414141;
    border-radius: 4px;
}

.navigation-button:hover {
    background-color: #2a2a2a;
    border-color: #ff9800;
}

.navigation-button:active {
    background-color: #343434;
}

#open-settings {
    right: 32px;

    width: 154px;
}

#open-news {
    right: 198px;

    width: 134px;
}

#open-info {
    right: 344px;

    width: 44px;

    font-size: 18px;
}

#launcher-control {
    position: absolute;

    left: 32px;
    right: 32px;
    bottom: 32px;

    height: 54px;
}

#loading-status {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 18px;

    font-size: 18px;
    color: #e8e8e8;

    opacity: 1;
}

#loading-progress {
    position: absolute;

    left: 0;
    bottom: 0;

    width: 320px;
    height: 7px;

    overflow: hidden;

    background-color: #323232;

    border-radius: 4px;
}

#loading-progress-value {
    position: absolute;

    left: 0;
    top: 0;

    width: 0%;
    height: 100%;

    background-color: #ff9800;

    border-radius: 4px;
}

#play-morph-label {
    position: absolute;

    left: 0;
    top: 16px;

    width: 100%;

    text-align: center;
    white-space: nowrap;

    font-size: 22px;
    color: #0e0e0e;

    opacity: 0;
}

#play-button {
    display: none;

    position: absolute;

    left: 0;
    bottom: 0;

    width: 320px;
    height: 54px;

    padding: 0;

    font-family: Monocraft;
    font-size: 22px;

    color: #0e0e0e;
    background-color: #ff9800;

    border-width: 1px;
    border-color: #ff9800;
    border-radius: 5px;
}

#play-button:hover {
    background-color: #ffb74d;
    border-color: #ffb74d;
}

#play-button:active {
    background-color: #e68200;
    border-color: #e68200;
}

.button-label {
    position: absolute;

    left: 0;
    top: 13px;

    width: 100%;

    text-align: center;
    white-space: nowrap;
}

#play-button .button-label {
    top: 16px;
}
