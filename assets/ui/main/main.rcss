#main-background {
    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    background-color: #181818;

    decorator: linear-gradient(to bottom, #141414, #040404);
}

#main-title {
    position: absolute;

    left: 4%;
    top: 30px;

    font-size: 32px;
    color: #e8e8e8;
}

#launcher-version {
    position: absolute;

    left: 4%;
    top: 78px;

    font-size: 16px;
    color: #9a9a9a;
}

#main-navigation {
    position: absolute;

    right: 4%;
    top: 25px;

    width: 356px;
    height: 44px;

    display: flex;
    flex-direction: row;

    align-items: stretch;
    justify-content: flex-end;
}

.navigation-button {
    position: relative;

    height: 44px;

    margin-left: 12px;
    padding: 0;

    flex: none;

    display: flex;
    flex-direction: row;

    align-items: center;
    justify-content: center;

    font-size: 16px;

    color: #e8e8e8;
    background-color: #1c1c1c;

    border-width: 1px;
    border-color: #414141;
    border-radius: 4px;
}

.navigation-button:hover {
    background-color: #2a2a2a;
    border-color: #ff9800;
}

.navigation-button:active {
    background-color: #343434;
}

#open-info {
    width: 44px;

    margin-left: 0;

    font-size: 18px;
}

#open-news {
    width: 134px;
}

#open-settings {
    width: 154px;
}

#launcher-control {
    position: absolute;

    left: 4%;
    bottom: 32px;

    width: 92%;
    height: 54px;
}

#loading-status {
    position: absolute;

    left: 0;
    bottom: 18px;

    width: 100%;

    text-align: left;

    font-size: 18px;
    color: #e8e8e8;

    opacity: 1;
}

#loading-progress {
    position: absolute;

    left: 0;
    bottom: 0;

    width: 320px;
    height: 7px;

    overflow: hidden;

    background-color: #323232;

    border-radius: 4px;
}

#loading-progress-value {
    position: absolute;

    left: 0;
    top: 0;

    width: 0%;
    height: 100%;

    background-color: #ff9800;

    border-radius: 4px;
}

#play-morph-label {
    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: row;

    align-items: center;
    justify-content: center;

    font-size: 20px;

    color: #0e0e0e;

    opacity: 0;
}

#play-button {
    display: none;

    position: absolute;

    left: 0;
    bottom: 0;

    width: 320px;
    height: 54px;

    padding: 0;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    font-size: 20px;

    color: #0e0e0e;
    background-color: #ff9800;

    border-width: 0;
    border-radius: 3px;

    opacity: 0;
}

#play-button:hover {
    background-color: #ffad33;
}

#play-button:active {
    background-color: #e68900;
}
