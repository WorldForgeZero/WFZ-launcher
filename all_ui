/*
 * Vertical scrollbar.
 *
 * RmlUi has no default styling for generated scrollbars.
 * Without an explicit width the scrollbar can consume the
 * content area's width.
 */
scrollbarvertical {
    width: 10px;

    background-color: #121212;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: 10px;

    background-color: #181818;
}

scrollbarvertical sliderbar {
    width: 8px;
    min-height: 28px;

    margin-left: 1px;

    background-color: #4a4a4a;

    border-radius: 4px;
}

scrollbarvertical sliderbar:hover {
    background-color: #686868;
}

scrollbarvertical sliderbar:active {
    background-color: #ff9800;
}

/*
 * Checkboxes.
 *
 * RmlUi automatically adds the input type as a class,
 * so <input type="checkbox"> matches input.checkbox.
 */
input.checkbox {
    width: 22px;
    height: 22px;

    padding: 0;

    background-color: #151515;

    border-width: 1px;
    border-color: #555555;
    border-radius: 3px;
}

input.checkbox:hover {
    border-color: #ff9800;
}

input.checkbox:checked {
    background-color: #ff9800;
    border-color: #ff9800;
}

#settings-search {
    position: absolute;

    left: 4%;
    top: 72px;

    width: 92%;
    height: 44px;

    box-sizing: border-box;

    padding-left: 14px;
    padding-right: 14px;

    line-height: 42px;

    font-size: 16px;

    color: #e8e8e8;
    background-color: #1c1c1c;

    border-width: 1px;
    border-color: #414141;
    border-radius: 4px;
}

